# Copy to backend/.env (the Makefile loads it). Everything is optional: with no keys the
# demo runs on the rule-based runbook.

# --- LLM agent ---
ANTHROPIC_API_KEY=
FLOORWALKER_MODEL=claude-haiku-5-5
FLOORWALKER_AGENT_MODE=auto          # auto | llm | fallback
FLOORWALKER_LLM_POSTMORTEM=1         # 0 = template postmortems, saves one LLM call per incident

# --- Tracing (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Server ---
SIM_SPEED=60                         # sim-minutes per real minute
CORS_ORIGINS=*                       # set to the dashboard's URL if you host it
ADMIN_TOKEN=                         # required for /api/admin/* when set. SET THIS IN PRODUCTION.
CHAOS_MAX_PER_HOUR=10                # public rate limit on "Break something"
